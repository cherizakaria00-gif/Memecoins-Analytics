# Required to enable the Phantom mobile QR code after HTTPS deployment.
PUBLIC_APP_URL=https://your-domain.example

# Required later for a universal WalletConnect/Reown QR supporting many wallets.
REOWN_PROJECT_ID=

# Optional: X (Twitter) API v2 bearer token to show recent tweets and a sentiment read per coin.
# Needs an X API plan with recent-search access (paid). Never commit the real value.
X_BEARER_TOKEN=

# --- SaaS: accounts and the $20/month subscription ---
# Public URL of the app (https in production: it enables Secure cookies and is used for Stripe redirects).
APP_URL=http://127.0.0.1:4173
# Stripe: https://dashboard.stripe.com/apikeys (use sk_test_… while testing) and a webhook endpoint
# pointing to APP_URL/api/billing/webhook with the events:
#   checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional free trial in days (0 = none).
TRIAL_DAYS=0
# Emails that get free access (owner / testers), comma separated.
ADMIN_EMAILS=
# Local testing only: lets a signed-in user activate a fake subscription without Stripe. Ignored on https URLs.
DEV_BILLING=0
# SQLite file for accounts and subscriptions (default: data/pulse.db).
DATABASE_FILE=

# --- Live trading (real orders signed by the user's own wallet; Pulse never holds keys or funds) ---
# 0 disables the live mode for everybody.
LIVE_TRADING=1
# Maximum size of one live buy, in SOL.
LIVE_MAX_ORDER_SOL=5
# Jupiter swap API (default: the free lite endpoint). Set JUPITER_API_KEY with https://api.jup.ag for higher limits.
JUPITER_API_URL=
JUPITER_API_KEY=

# --- Paiement crypto (validation manuelle depuis l'admin) ---
# Adresses de réception (publiques). Laisse vide pour désactiver une famille de réseaux.
# PAY_ADDRESS_SOLANA=
# Une seule adresse 0x… sert pour Ethereum, Polygon et BNB Chain (ou définis PAY_ADDRESS_ETHEREUM / PAY_ADDRESS_POLYGON / PAY_ADDRESS_BSC).
# PAY_ADDRESS_EVM=

# --- Commission Pulse sur les swaps LIVE ---
# PLATFORM_FEE_ACCOUNT : compte de jetons SOL wrappé (wSOL) qui reçoit les frais ; sans lui, aucune commission n'est prélevée.
# PLATFORM_FEE_BPS : 50 = 0,5 % (maximum 100).
# PLATFORM_FEE_ACCOUNT=
# PLATFORM_FEE_BPS=50


# --- Alertes Telegram (bot unique de la plateforme) ---
# Crée un bot avec @BotFather et colle son token ici. Chaque abonné le lie à son propre Telegram depuis la cloche de notifications.
# TELEGRAM_BOT_TOKEN=

# --- Jupiter (clé gratuite sur https://portal.jup.ag) ---
# Données enrichies (holders, Organic Score, authorities, acheteurs organiques) pour le Sniper Score + limites plus hautes pour les swaps LIVE.
# JUPITER_API_KEY=

# QUALITY_REQUIRE_SOCIALS=0 désactive l'exigence "site web + au moins un réseau social" du Filtre Pulse (activée par défaut).

# RUGCHECK=0 désactive la vérification RugCheck (API publique sans clé, utilisée sur les tokens prometteurs uniquement).

# --- Analyse du wallet (onglet Wallet) ---
# Le RPC public Solana limite fortement getTransaction : sans URL dédiée, seules quelques transactions sont lues.
# Mets une URL RPC Helius gratuite (https://mainnet.helius-rpc.com/?api-key=...) dans SOLANA_RPC_URL : Pulse utilise alors l'API de transactions enrichies de Helius (jusqu'à 400 swaps, pump.fun inclus) au lieu de lire les transactions une par une.
# SOLANA_RPC_URL=

# --- CoinGecko (clé demo gratuite sur coingecko.com/en/api) ---
# Les bougies des graphiques passent par l'API on-chain de CoinGecko avec ta clé (limite de requêtes à toi, au lieu de celle partagée par IP).
# COINGECKO_PRO=1 si tu as une clé payante (pro-api.coingecko.com).
# COINGECKO_API_KEY=

# --- Calls d'un canal Telegram ---
# Token du bot (BotFather) ajouté comme administrateur de TON canal : chaque post avec un lien DexScreener ou une adresse devient un call (notification + Channel Call Bot).
# TELEGRAM_CHANNEL_BOT_TOKEN=
# CHANNEL_CALLS_AUDIENCE=subscribers  (par défaut, seul l'administrateur voit les calls)
